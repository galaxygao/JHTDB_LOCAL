# Track source code, configuration and tests only.
*
!*/
!*.py
!*.pyi
!*.c
!*.cpp
!*.h
!*.hpp
!*.m
!*.sh
!*.ps1
!*.toml
!*.yaml
!*.yml
!/configs/**/*.json
!/qpower_analysis/config*.json
!/tests/**
!**/tests/**
!.gitignore
!.gitattributes
!Makefile
!requirements*.txt

# Runtime artifacts stay local even when they contain code/config snapshots.
output/
outputs/
result/
results/
review_png/
state/
inputs/
cache/
logs/
.scratch/
.local/
.DS_Store
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.venv/
.venv-mac/
.venv-windows/
.venv-linux/
.env
.env.*
.secrets/
*.zarr/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.partial
configs/*.local.yaml
